{
  "name": "azeroth-pinpoint",
  "private": true,
  "version": "0.1.0",
  "description": "A daily Azeroth geo-guessing game: five places a day, drop a pin as close as you can on the WoW: Forever world map.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-map.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-map.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "fetch-map": "node scripts/fetch-map.mjs",
    "build-data": "node scripts/build-data.mjs",
    "make-og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@netlify/database": "^2.0.3",
    "@tsparticles/basic": "^4.5.3",
    "@tsparticles/engine": "^4.5.3",
    "canvas-confetti": "^1.9.4",
    "gsap": "^3.15.1",
    "leaflet": "^1.9.4",
    "seedrandom": "^3.0.5",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@netlify/database-dev": "^1.0.2",
    "@netlify/functions": "^6.1.1",
    "@netlify/vite-plugin": "^3.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/seedrandom": "^3.0.8",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
